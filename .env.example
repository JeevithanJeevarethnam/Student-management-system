# ==========================================
# Root Environment Configuration for Docker Compose
# ==========================================

# Secret key for JWT signature (generate a random 32+ character string)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# Port for backend API inside the container
PORT=5000

# MongoDB URI (service name 'mongodb' resolves inside the Docker network)
MONGODB_URI=mongodb://mongodb:27017/student_management

# CORS allowed client URL
CLIENT_URL=http://localhost:5173
